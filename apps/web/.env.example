# Copy to apps/web/.env.local. `scripts/setup-auth0.sh` writes the AUTH0 values.
#
# Everything here reaches the browser. That is fine: a SPA client id is public
# by design, and the Authorization Code + PKCE flow does not use a secret.

NEXT_PUBLIC_AUTH0_DOMAIN=
# The SPA application's client id — not the Regular Web Application Cypress uses.
NEXT_PUBLIC_AUTH0_CLIENT_ID=
# Must match AUTH0_AUDIENCE in apps/api/.env, or Auth0 issues an opaque token
# the API cannot verify.
NEXT_PUBLIC_AUTH0_AUDIENCE=

NEXT_PUBLIC_API_URL=http://localhost:4000

# Copy to apps/api/.env. `scripts/setup-auth0.sh` writes the AUTH0_* values.

# Supabase Postgres over the Supavisor pooler in session mode — Connect ->
# "Session pooler" in the Supabase dashboard, not "Transaction pooler" (no
# prepared statements) and not the direct connection (IPv6-first). Percent-encode
# any of :/?#[]@ in the password.
# postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Optional. Path to Supabase's CA certificate (dashboard -> Settings -> Database
# -> SSL configuration). Set it and the connection's certificate is verified;
# leave it empty and the connection is encrypted but not authenticated — the
# trade `src/db/client.ts` documents, and fine for a local target only.
DATABASE_CA_CERT=

# The tenant, without a scheme: the issuer is derived as https://<domain>/
AUTH0_DOMAIN=
# The API identifier registered in Auth0. Every access token must name it.
AUTH0_AUDIENCE=

PORT=4000
# The single browser origin CORS admits.
WEB_ORIGIN=http://localhost:3000

# Optional; unset means development. Anything but `production` mounts the
# generated API description and Swagger UI at /api/docs — see src/docs/router.ts.
NODE_ENV=

{
  "name": "insightt-crud",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm run dev -w @insightt/api\" \"npm run dev -w @insightt/web\"",
    "build": "npm run typecheck --workspaces --if-present && npm run build --workspaces --if-present",
    "start": "npm run start -w @insightt/web",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "start-server-and-test dev \"http://localhost:3000|tcp:localhost:4000\" \"cypress run\"",
    "db:generate": "npm run db:generate -w @insightt/api",
    "db:migrate": "npm run db:migrate -w @insightt/api",
    "db:seed": "npm run db:seed -w @insightt/api",
    "docs:api": "npm run docs:api -w @insightt/api",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p cypress/tsconfig.json",
    "prepare": "husky"
  },
  "devDependencies": {
    "concurrently": "^9.2.4",
    "cypress": "^16.0.0",
    "husky": "^9.1.7",
    "start-server-and-test": "^3.0.12",
    "typescript": "^5"
  }
}

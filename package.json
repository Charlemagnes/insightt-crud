{
  "name": "insightt-crud",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm run dev -w @insightt/api\" \"npm run dev -w @insightt/web\"",
    "build": "npm run build --workspaces --if-present",
    "start": "npm run start -w @insightt/web",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^9.2.4",
    "typescript": "^5"
  }
}
